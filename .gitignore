# The Claude Code OAuth token run.sh reads and hands the box. Anchored to the
# repo root so it cannot be missed, and the one line in here that actually
# matters -- this repo is public.
/token

# Optional per-machine compose layer (see COMPOSE_OVERRIDE in the Makefile),
# and the in-box CLAUDE.md it mounts. This checkout's owner symlinks both out
# to a synced dotfiles repo. Keep secrets out of the override -- it syncs.
/docker-compose.override.yml
/CLAUDE.md
/env-vars
/tracker.env

# Generated by write-compose-ports.sh on every run.
/compose.ports.yml
/compose.ports.locked.yml

# Build-context staging for the image's dependency pre-warm: copies of the
# rhizome checkout's deps.edn / shadow-cljs.edn / package*.json / vendor and
# us-vs-them's deps.edn, refreshed by run.sh on every run. Derived files,
# never edited.
/.build-stage/

# The container-private lockfile run.sh seeds from the rhizome checkout, so an
# in-box `npm install` cannot rewrite the real one through the bind mount.
/package-lock.json

.claude/settings.local.json
.DS_Store
