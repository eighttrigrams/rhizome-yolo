{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path=/usr/local/bin/pw-chromium",
        "--viewport-size=1400x900",
        "--output-dir=.playwright-mcp"
      ]
    }
  }
}
